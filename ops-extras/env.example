# 辨妄阁后端环境变量（Linux 示例；Windows 见 ops/start-api.cmd 里的 setx）
# 用法：sudo cp ops/env.example /etc/bianwang.env && sudo chmod 600 /etc/bianwang.env

NODE_ENV=production

# 后端只监听回环，公网入口由 Nginx 反代
BW_HOST=127.0.0.1
BW_PORT=8787

# 数据目录：必须不在 Nginx web root 下
BW_DATA_DIR=/srv/bianwang/api/data

# 会话与全部签名（图片直链、镜像口令令牌、CSRF）的主密钥。
# 生成：openssl rand -hex 32
# 多实例必须一致；缺失时后端首启会自动生成 data/.secret（0600），换密钥＝旧会话与旧直链全部作废
BW_SECRET=请替换为 64 位以上十六进制随机串

# 需求默认把口令明文存 users.csv。公网部署请打开哈希（scrypt），改一次密码后即生效
BW_HASH_PASSWORDS=1

# 名册接口是否回显口令列（默认 0 不回显；只在需要核对时临时开）
BW_SHOW_PASSWORDS=0

# 可选：档案版本台账每档留几版完整快照（默认 30）
#BW_REVISION_KEEP=30

# 可选：登录写操作每分钟上限（默认 40，命中返回 429）。批量导入时临时调高，跑完改回
#BW_WRITE_LIMIT_PER_MIN=40

# 可选：阅览阈值（默认按需求取值，一般不用动）
#BW_READ_SPLIT_MB=10
#BW_READ_PAGE_MAX_KB=128
#BW_READ_WHOLE_MAX_KB=1024
#BW_READ_ENTRY_MAX_MB=16
#BW_LIBRARY_MAX_MB=120
#BW_PDF_PAGES_PER_CHAPTER=12

# 调试用：1 时放行 curl/wget 等脚本型 UA。**公网机不要开**
#BW_ALLOW_TOOL_UA=0
