node_modules/
dist/
*.log
.DS_Store
web/.vite/
# 运行期数据整体不入库：口令是明文 CSV、会话与审计日志含敏感状态，
# 演示内容一律由 `pnpm seed` 重建（详见 README「一、快速开始」的逐文件行为说明）
server/data/
# 启动时自动生成的本地口令速查（含明文口令，绝不入库/入部署包）
口令.txt
# 会话内的一次性取证、走查与备份产物（备份里含 users.csv，绝不入库）
.scratch-*/
outputs/
# 验收脚本每轮落盘的报告（含实测值与时间戳，是运行态不是源码，与打包时的排除口径一致）
verify-report-*.md
# 两处 exe 都是**目标机现编**的编译产物（源码在 dashboard/Dashboard.cs；installer/Installer.cs 已退役，见 DEVELOPMENT D-19），
# 既不入库也不入部署包（站点树那半的硬闸是"包内零 .exe"；离线包里的 exe 只有 runtime\ 那一套 Electron，由 make-offline-package.mjs 按白名单逐件核对）
dashboard/*.exe
installer/*.exe
# 仪表盘依赖探针的临时脚本（跑完即删，绝不能入库/入包）
.bianwang-deps-probe.mjs
server/.bianwang-deps-probe.mjs
# 一键安装包在目标机上落下的机器状态：端口登记、安装落点、引擎回显报告、起站日志。不入库也不入包
installer/port.txt
installer/target.txt
installer/setup-report-*.txt
installer/run-site.log
.qoder-credits/
.env
.env.local
